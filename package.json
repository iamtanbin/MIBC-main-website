    "deploy": "npm run build && wrangler deploy",
    "brand:assets": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
