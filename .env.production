# Public, non-secret build settings (committed on purpose).
# Cloudflare Builds "Build variables" with the same names override these.

# Absolute site origin, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
# TODO: replace <subdomain> with the account's workers.dev subdomain, or the custom domain once live.
NEXT_PUBLIC_SITE_URL=https://mibc-main-website.SUBDOMAIN.workers.dev

# "true" lets search engines index the site. Keep "false" until real content replaces placeholders.
NEXT_PUBLIC_ALLOW_INDEXING=false
